{
  "name": "fakebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "run-p watch serve",
    "watch": "node scripts/watch.mjs",
    "serve": "npx http-server dist -c-1 -p 4173",
    "build": "node scripts/build.mjs",
    "build:analyze": "node scripts/build.mjs --analyze",
    "build:sourcemap": "node scripts/build.mjs --sourcemap",
    "lint": "npx biome check --write .",
    "test": "npx vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@vitest/coverage-v8": "latest",
    "esbuild": "latest",
    "fake-indexeddb": "latest",
    "html-minifier-terser": "latest",
    "http-server": "latest",
    "lightningcss": "latest",
    "npm-run-all": "latest",
    "vitest": "latest"
  }
}